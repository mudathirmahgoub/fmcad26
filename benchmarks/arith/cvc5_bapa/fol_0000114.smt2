
(set-logic HO_ALL)
(declare-const u!4 Int)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const f!0!2 Int)
(declare-const UNIVERALSET!1!3 Int)
(declare-const t Int)
(declare-const n Int)
(declare-const c_fb Int)
(declare-const b_fa Int)
(assert (>= u!4 0))
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= f!0!2 0))
(assert (>= UNIVERALSET!1!3 0))
; A formulas
(assert (and (and (= u!4 0)
     (= u!5 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!6 t)
     (<= c_fb n)
     (>= c_fb 0)
     (>= (* 2 c_fb) (+ (- n t) 1))
     (<= b_fa n)
     (>= b_fa 0)
     (>= (* 2 b_fa) (+ n (* 3 t) 1))
     (< (- (+ c_fb b_fa u!5) (* 2 n)) 1)
     (> 1 0))
))
(assert 
  (int.star-contains 
    (lambda ((u!4 Int)(u!5 Int)(u!6 Int)(f!0!2 Int)(UNIVERALSET!1!3 Int)) 
      (and 
        (= u!4 (ite (> f!0!2 UNIVERALSET!1!3) 1 0))
        (= u!5 (ite (> UNIVERALSET!1!3 0) 1 0))
        (= u!6 (ite (> f!0!2 0) 1 0))
        (>= f!0!2 0)
        (>= UNIVERALSET!1!3 0)
        ))
    u!4 u!5 u!6 f!0!2 UNIVERALSET!1!3 ))
(check-sat)