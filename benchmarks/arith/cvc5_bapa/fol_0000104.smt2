
(set-logic HO_ALL)
(declare-const u!4 Int)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const u!7 Int)
(declare-const f!0!2 Int)
(declare-const UNIVERALSET!1!3 Int)
(declare-const c_el Int)
(declare-const t Int)
(declare-const n Int)
(declare-const a_ej Int)
(declare-const b_ek Int)
(assert (>= u!4 0))
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= u!7 0))
(assert (>= f!0!2 0))
(assert (>= UNIVERALSET!1!3 0))
; A formulas
(assert (and (let ((a!1 (< (- (+ c_el b_ek (* 2 a_ej) u!7) (* 4 n)) 1)))
  (and (= u!4 0)
       (= u!5 n)
       (> n 0)
       (> n (* 3 t))
       (<= u!6 t)
       (<= c_el n)
       (>= c_el 0)
       (>= (* 2 c_el) (+ (- n t) 1))
       (<= b_ek n)
       (>= b_ek 0)
       (>= (* 2 b_ek) (+ n (* 3 t) 1))
       (<= a_ej n)
       (>= a_ej 0)
       (>= a_ej (- n t))
       a!1
       (> 1 0)))
))
(assert 
  (int.star-contains 
    (lambda ((u!4 Int)(u!5 Int)(u!6 Int)(u!7 Int)(f!0!2 Int)(UNIVERALSET!1!3 Int)) 
      (and 
        (= u!4 (ite (> f!0!2 UNIVERALSET!1!3) 1 0))
        (= u!5 (ite (> UNIVERALSET!1!3 0) 1 0))
        (= u!6 (ite (> f!0!2 0) 1 0))
        (let ((a!1 (ite (> (ite (<= UNIVERALSET!1!3 f!0!2) 0 (- UNIVERALSET!1!3 f!0!2))
                   0)
                1
                0)))
  (= u!7 a!1))
        (>= f!0!2 0)
        (>= UNIVERALSET!1!3 0)
        ))
    u!4 u!5 u!6 u!7 f!0!2 UNIVERALSET!1!3 ))
(check-sat)