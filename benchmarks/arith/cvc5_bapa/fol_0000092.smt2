
(set-logic HO_ALL)
(declare-const u!4 Int)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const f!0!2 Int)
(declare-const UNIVERALSET!1!3 Int)
(declare-const c_dn Int)
(declare-const a_dm Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!4 0))
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= f!0!2 0))
(assert (>= UNIVERALSET!1!3 0))
; A formulas
(assert (and (and (= u!4 0)
     (= u!5 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!6 t)
     (<= c_dn n)
     (>= c_dn 0)
     (>= (* 2 c_dn) (+ (- n t) 1))
     (<= a_dm n)
     (>= a_dm 0)
     (>= a_dm (- n t))
     (< (- (+ c_dn a_dm u!5) (* 2 n)) 1)
     (> 1 0))
))
(assert
  (int.star-contains
    (lambda ((u!4 Int)(u!5 Int)(u!6 Int)(f!0!2 Int)(UNIVERALSET!1!3 Int))
      (and
        (>= u!4 0)
        (>= u!5 0)
        (>= u!6 0)
        (= u!4 (ite (> f!0!2 UNIVERALSET!1!3) 1 0))
        (= u!5 (ite (> UNIVERALSET!1!3 0) 1 0))
        (= u!6 (ite (> f!0!2 0) 1 0))
        (>= f!0!2 0)
        (>= UNIVERALSET!1!3 0)
        ))
    u!4 u!5 u!6 f!0!2 UNIVERALSET!1!3 ))
(check-sat)