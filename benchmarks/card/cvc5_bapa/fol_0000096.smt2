
(set-logic HO_ALL)
(declare-const u!7 Int)
(declare-const u!8 Int)
(declare-const u!9 Int)
(declare-const u!11 Int)
(declare-const u!12 Int)
(declare-const u!14 Int)
(declare-const u!15 Int)
(declare-const u!17 Int)
(declare-const u!18 Int)
(declare-const u!19 Int)
(declare-const a_ef!4!16 Int)
(declare-const a_eh!2!10 Int)
(declare-const a_eg!3!13 Int)
(declare-const UNIVERALSET!1!6 Int)
(declare-const f!0!5 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!7 0))
(assert (>= u!8 0))
(assert (>= u!9 0))
(assert (>= u!11 0))
(assert (>= u!12 0))
(assert (>= u!14 0))
(assert (>= u!15 0))
(assert (>= u!17 0))
(assert (>= u!18 0))
(assert (>= u!19 0))
(assert (>= a_ef!4!16 0))
(assert (>= a_eh!2!10 0))
(assert (>= a_eg!3!13 0))
(assert (>= UNIVERALSET!1!6 0))
(assert (>= f!0!5 0))
; A formulas
(assert (and (and (= u!7 0)
     (= u!8 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!9 t)
     (= u!11 0)
     (>= u!12 (- n t))
     (= u!14 0)
     (>= u!15 (- n t))
     (= u!17 0)
     (>= u!18 (- n t))
     (= u!19 0))
))
(assert 
  (int.star-contains 
    (lambda ((u!7 Int)(u!8 Int)(u!9 Int)(u!11 Int)(u!12 Int)(u!14 Int)(u!15 Int)(u!17 Int)(u!18 Int)(u!19 Int)(a_ef!4!16 Int)(a_eh!2!10 Int)(a_eg!3!13 Int)(UNIVERALSET!1!6 Int)(f!0!5 Int)) 
      (and 
        (= u!7 (ite (> f!0!5 UNIVERALSET!1!6) 1 0))
        (= u!8 (ite (> UNIVERALSET!1!6 0) 1 0))
        (= u!9 (ite (> f!0!5 0) 1 0))
        (= u!11 (ite (> a_eh!2!10 UNIVERALSET!1!6) 1 0))
        (= u!12 (ite (> a_eh!2!10 0) 1 0))
        (= u!14 (ite (> a_eg!3!13 UNIVERALSET!1!6) 1 0))
        (= u!15 (ite (> a_eg!3!13 0) 1 0))
        (= u!17 (ite (> a_ef!4!16 UNIVERALSET!1!6) 1 0))
        (= u!18 (ite (> a_ef!4!16 0) 1 0))
        (let ((a!1 (ite (>= (ite (>= a_eh!2!10 a_eg!3!13) a_eg!3!13 a_eh!2!10)
                    a_ef!4!16)
                a_ef!4!16
                (ite (>= a_eh!2!10 a_eg!3!13) a_eg!3!13 a_eh!2!10))))
(let ((a!2 (ite (>= a!1
                    (ite (<= UNIVERALSET!1!6 f!0!5) 0 (- UNIVERALSET!1!6 f!0!5)))
                (ite (<= UNIVERALSET!1!6 f!0!5) 0 (- UNIVERALSET!1!6 f!0!5))
                a!1)))
  (= u!19 (ite (> a!2 0) 1 0))))
        (>= f!0!5 0)
        (>= UNIVERALSET!1!6 0)
        (>= a_eh!2!10 0)
        (>= a_eg!3!13 0)
        (>= a_ef!4!16 0)
        ))
    u!7 u!8 u!9 u!11 u!12 u!14 u!15 u!17 u!18 u!19 a_ef!4!16 a_eh!2!10 a_eg!3!13 UNIVERALSET!1!6 f!0!5 ))
(check-sat)