        (= u!16 (ite (> b_fn!3!14 0) 1 0))
        (= u!18 (ite (> a_fm!4!17 UNIVERALSET!1!7) 1 0))
        (= u!19 (ite (> a_fm!4!17 0) 1 0))
        (= u!21 (ite (> a_fl!5!20 UNIVERALSET!1!7) 1 0))
        (= u!22 (ite (> a_fl!5!20 0) 1 0))
        (let ((a!1 (ite (>= (ite (>= c_fo!2!11 b_fn!3!14) b_fn!3!14 c_fo!2!11)
