                a_fm!4!17
                (ite (>= c_fo!2!11 b_fn!3!14) b_fn!3!14 c_fo!2!11))))
(let ((a!2 (ite (>= (ite (>= a!1 a_fl!5!20) a_fl!5!20 a!1)
                    (ite (<= UNIVERALSET!1!7 f!0!6) 0 (- UNIVERALSET!1!7 f!0!6)))
                (ite (<= UNIVERALSET!1!7 f!0!6) 0 (- UNIVERALSET!1!7 f!0!6))
                (ite (>= a!1 a_fl!5!20) a_fl!5!20 a!1))))
