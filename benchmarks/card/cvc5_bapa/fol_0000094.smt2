
(set-logic HO_ALL)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const u!7 Int)
(declare-const u!9 Int)
(declare-const u!10 Int)
(declare-const u!11 Int)
(declare-const f!0!3 Int)
(declare-const UNIVERALSET!1!4 Int)
(declare-const c_ec!2!8 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= u!7 0))
(assert (>= u!9 0))
(assert (>= u!10 0))
(assert (>= u!11 0))
(assert (>= f!0!3 0))
(assert (>= UNIVERALSET!1!4 0))
(assert (>= c_ec!2!8 0))
; A formulas
(assert (and (and (= u!5 0)
     (= u!6 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!7 t)
     (= u!9 0)
     (>= (* 2 u!10) (+ (- n t) 1))
     (= u!11 0))
))
(assert
  (int.star-contains
    (lambda ((u!5 Int)(u!6 Int)(u!7 Int)(u!9 Int)(u!10 Int)(u!11 Int)(f!0!3 Int)(UNIVERALSET!1!4 Int)(c_ec!2!8 Int))
      (and
        (>= u!5 0)
        (>= u!6 0)
        (>= u!7 0)
        (>= u!9 0)
        (>= u!10 0)
        (>= u!11 0)
        (= u!5 (ite (> f!0!3 UNIVERALSET!1!4) 1 0))
        (= u!6 (ite (> UNIVERALSET!1!4 0) 1 0))
        (= u!7 (ite (> f!0!3 0) 1 0))
        (= u!9 (ite (> c_ec!2!8 UNIVERALSET!1!4) 1 0))
        (= u!10 (ite (> c_ec!2!8 0) 1 0))
        (let ((a!1 (ite (>= c_ec!2!8
                    (ite (<= UNIVERALSET!1!4 f!0!3) 0 (- UNIVERALSET!1!4 f!0!3)))
                (ite (<= UNIVERALSET!1!4 f!0!3) 0 (- UNIVERALSET!1!4 f!0!3))
                c_ec!2!8)))
  (= u!11 (ite (> a!1 0) 1 0)))
        (>= f!0!3 0)
        (>= UNIVERALSET!1!4 0)
        (>= c_ec!2!8 0)
        ))
    u!5 u!6 u!7 u!9 u!10 u!11 f!0!3 UNIVERALSET!1!4 c_ec!2!8 ))
(check-sat)