        (= u!19 a_fi!4!17)
        (= u!21 (ite (> a_fh!5!20 UNIVERALSET!1!7) 1 0))
        (= u!22 a_fh!5!20)
        (let ((a!1 (ite (>= (ite (>= b_fk!2!11 b_fj!3!14) b_fj!3!14 b_fk!2!11)
