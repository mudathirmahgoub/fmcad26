                a_fi!4!17
                (ite (>= b_fk!2!11 b_fj!3!14) b_fj!3!14 b_fk!2!11))))
(let ((a!2 (ite (>= (ite (>= a!1 a_fh!5!20) a_fh!5!20 a!1)
