(assert (>= UNIVERALSET!1!6 0))
(assert (>= a_y!4!16 0))
(assert (>= f!0!5 0))
(assert (>= b_z!3!13 0))
; A formulas
(assert (and (let ((a!1 (not (>= (* 2 u!19) (+ (- n t) 1)))))
  (and (= u!7 0)
       (= u!8 n)
       (> n 0)
       (> n (* 3 t))
       (<= u!9 t)
       (= u!11 0)
       (>= (* 2 u!12) (+ n (* 3 t) 1))
       (= u!14 0)
       (>= (* 2 u!15) (+ n (* 3 t) 1))
       (= u!17 0)
       (>= u!18 (- n t))
       a!1))
))
(assert 
  (int.star-contains 
    (lambda ((u!7 Int)(u!8 Int)(u!9 Int)(u!11 Int)(u!12 Int)(u!14 Int)(u!15 Int)(u!17 Int)(u!18 Int)(u!19 Int)(b_ba!2!10 Int)(UNIVERALSET!1!6 Int)(a_y!4!16 Int)(f!0!5 Int)(b_z!3!13 Int)) 
      (and 
        (= u!7 (ite (> f!0!5 UNIVERALSET!1!6) 1 0))
        (= u!8 UNIVERALSET!1!6)
        (= u!9 f!0!5)
        (= u!11 (ite (> b_ba!2!10 UNIVERALSET!1!6) 1 0))
        (= u!12 b_ba!2!10)
        (= u!14 (ite (> b_z!3!13 UNIVERALSET!1!6) 1 0))
        (= u!15 b_z!3!13)
        (= u!17 (ite (> a_y!4!16 UNIVERALSET!1!6) 1 0))
        (= u!18 a_y!4!16)
        (let ((a!1 (ite (>= (ite (>= b_ba!2!10 b_z!3!13) b_z!3!13 b_ba!2!10) a_y!4!16)
                a_y!4!16
                (ite (>= b_ba!2!10 b_z!3!13) b_z!3!13 b_ba!2!10))))
(let ((a!2 (ite (>= a!1
                    (ite (<= UNIVERALSET!1!6 f!0!5) 0 (- UNIVERALSET!1!6 f!0!5)))
                (ite (<= UNIVERALSET!1!6 f!0!5) 0 (- UNIVERALSET!1!6 f!0!5))
                a!1)))
  (= u!19 a!2)))
        (>= f!0!5 0)
        (>= UNIVERALSET!1!6 0)
        (>= b_ba!2!10 0)
        (>= b_z!3!13 0)
        (>= a_y!4!16 0)
        ))
    u!7 u!8 u!9 u!11 u!12 u!14 u!15 u!17 u!18 u!19 b_ba!2!10 UNIVERALSET!1!6 a_y!4!16 f!0!5 b_z!3!13 ))
(check-sat)