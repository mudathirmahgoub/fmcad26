
(set-logic HO_ALL)
(declare-const u!6 Int)
(declare-const u!7 Int)
(declare-const u!8 Int)
(declare-const u!10 Int)
(declare-const u!11 Int)
(declare-const u!13 Int)
(declare-const u!14 Int)
(declare-const u!15 Int)
(declare-const c_bj!2!9 Int)
(declare-const f!0!4 Int)
(declare-const UNIVERALSET!1!5 Int)
(declare-const b_bi!3!12 Int)
(declare-const n Int)
(declare-const t Int)
(assert (>= u!6 0))
(assert (>= u!7 0))
(assert (>= u!8 0))
(assert (>= u!10 0))
(assert (>= u!11 0))
(assert (>= u!13 0))
(assert (>= u!14 0))
(assert (>= u!15 0))
(assert (>= c_bj!2!9 0))
(assert (>= f!0!4 0))
(assert (>= UNIVERALSET!1!5 0))
(assert (>= b_bi!3!12 0))
; A formulas
(assert (and (let ((a!1 (not (>= (* 2 u!15) (+ (- n t) 1)))))
  (and (= u!6 0)
       (= u!7 n)
       (> n 0)
       (> n (* 3 t))
       (<= u!8 t)
       (= u!10 0)
       (>= (* 2 u!11) (+ (- n t) 1))
       (= u!13 0)
       (>= (* 2 u!14) (+ n (* 3 t) 1))
       a!1))
))
(assert
  (int.star-contains
    (lambda ((u!6 Int)(u!7 Int)(u!8 Int)(u!10 Int)(u!11 Int)(u!13 Int)(u!14 Int)(u!15 Int)(c_bj!2!9 Int)(f!0!4 Int)(UNIVERALSET!1!5 Int)(b_bi!3!12 Int))
      (and
        (>= u!6 0)
        (>= u!7 0)
        (>= u!8 0)
        (>= u!10 0)
        (>= u!11 0)
        (>= u!13 0)
        (>= u!14 0)
        (>= u!15 0)
        (= u!6 (ite (> f!0!4 UNIVERALSET!1!5) 1 0))
        (= u!7 UNIVERALSET!1!5)
        (= u!8 f!0!4)
        (= u!10 (ite (> c_bj!2!9 UNIVERALSET!1!5) 1 0))
        (= u!11 c_bj!2!9)
        (= u!13 (ite (> b_bi!3!12 UNIVERALSET!1!5) 1 0))
        (= u!14 b_bi!3!12)
        (let ((a!1 (ite (>= (ite (>= c_bj!2!9 b_bi!3!12) b_bi!3!12 c_bj!2!9)
                    (ite (<= UNIVERALSET!1!5 f!0!4) 0 (- UNIVERALSET!1!5 f!0!4)))
                (ite (<= UNIVERALSET!1!5 f!0!4) 0 (- UNIVERALSET!1!5 f!0!4))
                (ite (>= c_bj!2!9 b_bi!3!12) b_bi!3!12 c_bj!2!9))))
  (= u!15 a!1))
        (>= f!0!4 0)
        (>= UNIVERALSET!1!5 0)
        (>= c_bj!2!9 0)
        (>= b_bi!3!12 0)
        ))
    u!6 u!7 u!8 u!10 u!11 u!13 u!14 u!15 c_bj!2!9 f!0!4 UNIVERALSET!1!5 b_bi!3!12 ))
(check-sat)