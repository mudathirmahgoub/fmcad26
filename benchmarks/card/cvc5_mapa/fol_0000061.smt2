
(set-logic HO_ALL)
(declare-const u!5 Int)
(declare-const u!6 Int)
(declare-const u!7 Int)
(declare-const u!9 Int)
(declare-const u!10 Int)
(declare-const u!11 Int)
(declare-const UNIVERALSET!1!4 Int)
(declare-const a_bx!2!8 Int)
(declare-const f!0!3 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!5 0))
(assert (>= u!6 0))
(assert (>= u!7 0))
(assert (>= u!9 0))
(assert (>= u!10 0))
(assert (>= u!11 0))
(assert (>= UNIVERALSET!1!4 0))
(assert (>= a_bx!2!8 0))
(assert (>= f!0!3 0))
; A formulas
(assert (and (and (= u!5 0)
     (= u!6 n)
     (> n 0)
     (> n (* 3 t))
     (<= u!7 t)
     (= u!9 0)
     (>= u!10 (- n t))
     (= u!11 0))
))
(assert 
  (int.star-contains 
    (lambda ((u!5 Int)(u!6 Int)(u!7 Int)(u!9 Int)(u!10 Int)(u!11 Int)(UNIVERALSET!1!4 Int)(a_bx!2!8 Int)(f!0!3 Int)) 
      (and 
        (= u!5 (ite (> f!0!3 UNIVERALSET!1!4) 1 0))
        (= u!6 UNIVERALSET!1!4)
        (= u!7 f!0!3)
        (= u!9 (ite (> a_bx!2!8 UNIVERALSET!1!4) 1 0))
        (= u!10 a_bx!2!8)
        (let ((a!1 (ite (>= a_bx!2!8
                    (ite (<= UNIVERALSET!1!4 f!0!3) 0 (- UNIVERALSET!1!4 f!0!3)))
                (ite (<= UNIVERALSET!1!4 f!0!3) 0 (- UNIVERALSET!1!4 f!0!3))
                a_bx!2!8)))
  (= u!11 a!1))
        (>= f!0!3 0)
        (>= UNIVERALSET!1!4 0)
        (>= a_bx!2!8 0)
        ))
    u!5 u!6 u!7 u!9 u!10 u!11 UNIVERALSET!1!4 a_bx!2!8 f!0!3 ))
(check-sat)