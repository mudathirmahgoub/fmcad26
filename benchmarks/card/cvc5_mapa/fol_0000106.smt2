
(set-logic HO_ALL)
(declare-const u!8 Int)
(declare-const u!9 Int)
(declare-const u!10 Int)
(declare-const u!12 Int)
(declare-const u!13 Int)
(declare-const u!15 Int)
(declare-const u!16 Int)
(declare-const u!18 Int)
(declare-const u!19 Int)
(declare-const u!21 Int)
(declare-const u!22 Int)
(declare-const u!23 Int)
(declare-const b_fw!2!11 Int)
(declare-const f!0!6 Int)
(declare-const UNIVERALSET!1!7 Int)
(declare-const b_fv!3!14 Int)
(declare-const a_fu!4!17 Int)
(declare-const a_ft!5!20 Int)
(declare-const t Int)
(declare-const n Int)
(assert (>= u!8 0))
(assert (>= u!9 0))
(assert (>= u!10 0))
(assert (>= u!12 0))
(assert (>= u!13 0))
(assert (>= u!15 0))
(assert (>= u!16 0))
(assert (>= u!18 0))
(assert (>= u!19 0))
(assert (>= u!21 0))
(assert (>= u!22 0))
(assert (>= u!23 0))
(assert (>= b_fw!2!11 0))
(assert (>= f!0!6 0))
(assert (>= UNIVERALSET!1!7 0))
(assert (>= b_fv!3!14 0))
(assert (>= a_fu!4!17 0))
(assert (>= a_ft!5!20 0))
; A formulas
(assert (and (let ((a!1 (not (>= (* 2 u!23) (+ (- n t) 1)))))
  (and (= u!8 0)
       (= u!9 n)
       (> n 0)
       (> n (* 3 t))
       (<= u!10 t)
       (= u!12 0)
       (>= (* 2 u!13) (+ n (* 3 t) 1))
       (= u!15 0)
       (>= (* 2 u!16) (+ n (* 3 t) 1))
       (= u!18 0)
       (>= u!19 (- n t))
       (= u!21 0)
       (>= u!22 (- n t))
       a!1))
))
(assert 
  (int.star-contains 
    (lambda ((u!8 Int)(u!9 Int)(u!10 Int)(u!12 Int)(u!13 Int)(u!15 Int)(u!16 Int)(u!18 Int)(u!19 Int)(u!21 Int)(u!22 Int)(u!23 Int)(b_fw!2!11 Int)(f!0!6 Int)(UNIVERALSET!1!7 Int)(b_fv!3!14 Int)(a_fu!4!17 Int)(a_ft!5!20 Int)) 
      (and 
        (= u!8 (ite (> f!0!6 UNIVERALSET!1!7) 1 0))
        (= u!9 UNIVERALSET!1!7)
        (= u!10 f!0!6)
        (= u!12 (ite (> b_fw!2!11 UNIVERALSET!1!7) 1 0))
        (= u!13 b_fw!2!11)
        (= u!15 (ite (> b_fv!3!14 UNIVERALSET!1!7) 1 0))
        (= u!16 b_fv!3!14)
        (= u!18 (ite (> a_fu!4!17 UNIVERALSET!1!7) 1 0))
        (= u!19 a_fu!4!17)
        (= u!21 (ite (> a_ft!5!20 UNIVERALSET!1!7) 1 0))
        (= u!22 a_ft!5!20)
        (let ((a!1 (ite (>= (ite (>= b_fw!2!11 b_fv!3!14) b_fv!3!14 b_fw!2!11)
                    a_fu!4!17)
                a_fu!4!17
                (ite (>= b_fw!2!11 b_fv!3!14) b_fv!3!14 b_fw!2!11))))
(let ((a!2 (ite (>= (ite (>= a!1 a_ft!5!20) a_ft!5!20 a!1)
                    (ite (<= UNIVERALSET!1!7 f!0!6) 0 (- UNIVERALSET!1!7 f!0!6)))
                (ite (<= UNIVERALSET!1!7 f!0!6) 0 (- UNIVERALSET!1!7 f!0!6))
                (ite (>= a!1 a_ft!5!20) a_ft!5!20 a!1))))
  (= u!23 a!2)))
        (>= f!0!6 0)
        (>= UNIVERALSET!1!7 0)
        (>= b_fw!2!11 0)
        (>= b_fv!3!14 0)
        (>= a_fu!4!17 0)
        (>= a_ft!5!20 0)
        ))
    u!8 u!9 u!10 u!12 u!13 u!15 u!16 u!18 u!19 u!21 u!22 u!23 b_fw!2!11 f!0!6 UNIVERALSET!1!7 b_fv!3!14 a_fu!4!17 a_ft!5!20 ))
(check-sat)